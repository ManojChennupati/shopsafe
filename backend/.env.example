# ── Local Hardhat network ────────────────────────────────────────────────────
HARDHAT_RPC_URL=http://127.0.0.1:8545

# ── Contract (populated by deploy-local.js) ──────────────────────────────────
CONTRACT_ADDRESS=

# ── Backend operator account (Hardhat account #1 — NEVER use real keys) ──────
# This is the second default Hardhat test account private key — safe for local demo ONLY
OPERATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
OPERATOR_ADDRESS=

# ── Seller payout account (Hardhat account #2 — local demo ONLY) ─────────────
SELLER_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# ── Buyer simulation account (Hardhat account #3 — local demo ONLY) ──────────
BUYER_ADDRESS=0x90F79bf6EB2c4f870365E785982E1f101E93b906

# ── Escrow configuration ─────────────────────────────────────────────────────
ESCROW_AMOUNT_ETH=0.001
DISPUTE_WINDOW_SECONDS=300

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/shopsafe

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Demo credentials ──────────────────────────────────────────────────────────
# These are fixed demo passwords only — never use in production
ADMIN_PASSWORD=admin123
DELIVERY_PASSWORD=deliver123
